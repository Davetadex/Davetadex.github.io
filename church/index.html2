    <style id="sqs-search-preview-styles">
      .sqs-search-preview-ui {
        position: absolute;
        z-index: 999999;
        background-color: #fff;
        width: 100%;
      }

      .sqs-search-preview-ui.hide {
        display: none;
      }

      .sqs-search-preview-ui .sqs-search-ui-result {
        border-top: none;
        border: 1px solid #ddd;
      }

      .sqs-search-preview-ui .search-result-notice {
        background-color: #fff;
        font-weight: 200;
        font-size: 12px;
        padding: 6px 12px;
        color: #333;
      }

      .sqs-search-preview-ui .search-result-notice.hide {
        display: none;
      }

      .sqs-search-preview-ui .sqs-search-ui-list {
        max-height: 500px;
        overflow-x: hidden;
        overflow-y: scroll;
      }

      .sqs-search-preview-ui .search-result {
        padding: 16px;
        cursor: pointer;
        border-bottom: 1px solid #ddd;
        transition: background-color .2s ease-out;
      }

      .sqs-search-preview-ui .search-result:last-child {
        border-bottom: none;
      }

      .sqs-search-preview-ui .search-result.selected,
      .sqs-search-preview-ui .search-result:hover {
        background-color: #f5f5f5;
      }

      .sqs-search-preview-ui .search-result.selected {
        outline-color: #333;
      }

      .sqs-search-preview-ui .sqs-search-ui-item {
        border-top: none;
      }

      .sqs-search-preview-ui .sqs-search-ui-item em {
        color: #222;
        font-style: italic;
      }

      .sqs-search-preview-ui .sqs-main-image-container {
        width: 50px;
        float: right;
        margin-left: 5px;
        box-shadow: #ddd 1px -1px 5px;
      }

      .sqs-search-preview-ui .sqs-main-image-intrinsic {
        position: relative;
        width: 100%;
        height: 0;
        padding-bottom: 100%;
      }

      .sqs-search-preview-ui .sqs-main-image {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
      }

      .sqs-search-preview-ui .sqs-title {
        font-size: 16px;
        line-height: 1.2em;
        margin-bottom: 0.5em;
        color: #333;
      }

      .sqs-search-preview-ui .sqs-content {
        font-size: 12px;
        line-height: 1.4em;
        color: #333;
      }

      .sqs-search-preview-ui.no-image .sqs-main-image-container {
        display: none;
      }
    </style>
